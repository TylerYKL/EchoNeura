# ---------------------------------------------------------------------------
# EchoNeura configuration.  Copy to `.env` and edit.
#   cp .env.example .env
#
# Every variable is prefixed ECHONEURA_ and read by backend/app/core/config.py.
# The defaults run the whole product offline on the deterministic mock provider,
# so `make dev` works with an empty .env.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
ECHONEURA_ENVIRONMENT=development
ECHONEURA_DEBUG=true
ECHONEURA_HOST=0.0.0.0
ECHONEURA_PORT=8000
# Comma-separated browser origins allowed to call the API directly.
# The Next.js frontend proxies /api server-side, so this is only needed for
# direct browser access (e.g. the Swagger UI on a deployed host).
ECHONEURA_CORS_ORIGINS=*

# --- Storage / database ----------------------------------------------------
# SQLite for M1 (zero infra). For Postgres:
#   ECHONEURA_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/echoneura
# and add `psycopg[binary]` to backend/requirements.txt.
#ECHONEURA_DATABASE_URL=sqlite:///./data/echoneura.db
#ECHONEURA_UPLOAD_DIR=./data/uploads
ECHONEURA_MAX_UPLOAD_MB=500

# --- Provider selection ----------------------------------------------------
# asr:            mock | faster_whisper | assemblyai | deepgram | groq_whisper
# diarization:    none | mock | pyannote
#                 "none" = use the ASR vendor's bundled diarization when it has
#                 one (assemblyai/deepgram/mock); otherwise a single speaker.
#                 "pyannote" takes precedence over bundled diarization.
# enrichment:     mock | openai | anthropic        (M2: summary + quotes)
# assistant:      mock | openai | anthropic        (M1.5: live-voice actions;
#                 openai/anthropic are reserved hooks, not implemented yet)
ECHONEURA_ASR_PROVIDER=mock
ECHONEURA_DIARIZATION_PROVIDER=none
ECHONEURA_ENRICH_PROVIDER=mock
ECHONEURA_ASSISTANT_PROVIDER=mock

# --- Provider credentials (only the active provider needs a key) -----------
#ECHONEURA_ASSEMBLYAI_API_KEY=
#ECHONEURA_DEEPGRAM_API_KEY=
#ECHONEURA_GROQ_API_KEY=
#ECHONEURA_OPENAI_API_KEY=
#ECHONEURA_ANTHROPIC_API_KEY=
# pyannote/speaker-diarization-3.1 is gated: accept the conditions on the Hub first.
#ECHONEURA_HUGGINGFACE_TOKEN=

# --- Local model tuning (faster-whisper / pyannote) ------------------------
# tiny|base|small|medium|large-v3 ; int8 for CPU, float16 for GPU
ECHONEURA_WHISPER_MODEL_SIZE=base
ECHONEURA_WHISPER_DEVICE=auto
ECHONEURA_WHISPER_COMPUTE_TYPE=int8
ECHONEURA_PYANNOTE_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# --- Worker ----------------------------------------------------------------
# true  = the queue worker runs inside the API process (single container, dev)
# false = run it separately with `make dev-worker` (production)
ECHONEURA_WORKER_IN_PROCESS=true
ECHONEURA_WORKER_POLL_SECONDS=0.5
ECHONEURA_WORKER_MAX_CONCURRENT_JOBS=1
ECHONEURA_WORKER_LEASE_TIMEOUT_SECONDS=900

# --- Pipeline defaults -----------------------------------------------------
ECHONEURA_DEFAULT_LANGUAGE=auto
ECHONEURA_MAX_SRT_CHARS_PER_LINE=42
ECHONEURA_MAX_SRT_LINES_PER_CUE=2

# --- Live voice (M1.5) -----------------------------------------------------
# Where utterance audio is stored (wiped via DELETE /api/voice/utterances/{id})
#ECHONEURA_VOICE_DIR=./data/voice
# PCM sample rate clients should stream at (8000-48000 accepted per connection)
ECHONEURA_VOICE_SAMPLE_RATE=16000
# Per-utterance guards for the WebSocket ingest
ECHONEURA_VOICE_MAX_SECONDS=300
ECHONEURA_VOICE_MIN_SECONDS=0.4

# --- Feature flags (later milestones) --------------------------------------
ECHONEURA_ENABLE_SUMMARY=false
ECHONEURA_ENABLE_QUOTE_CARDS=false
ECHONEURA_ENABLE_TRANSLATOR=false

# --- Frontend --------------------------------------------------------------
# Server-side proxy target only; the browser never sees this value.
BACKEND_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Ready-to-run provider recipes
# ---------------------------------------------------------------------------
# Cheapest real ASR (no diarization, pair with pyannote if you have a GPU):
#   ECHONEURA_ASR_PROVIDER=groq_whisper
#   ECHONEURA_GROQ_API_KEY=gsk_...
#
# Best accuracy + built-in diarization, one API call:
#   ECHONEURA_ASR_PROVIDER=assemblyai
#   ECHONEURA_ASSEMBLYAI_API_KEY=...
#
# Low-latency synchronous ASR + diarization:
#   ECHONEURA_ASR_PROVIDER=deepgram
#   ECHONEURA_DEEPGRAM_API_KEY=...
#
# Fully self-hosted (needs a GPU box or Modal/RunPod):
#   pip install faster-whisper torch pyannote.audio
#   ECHONEURA_ASR_PROVIDER=faster_whisper
#   ECHONEURA_DIARIZATION_PROVIDER=pyannote
#   ECHONEURA_HUGGINGFACE_TOKEN=hf_...
#
# Real summaries + pull quotes (M2):
#   ECHONEURA_ENRICH_PROVIDER=openai
#   ECHONEURA_OPENAI_API_KEY=sk-...
#
# Real voice assistant (post-M1.5 — implement the provider first, see ADR 0004):
#   ECHONEURA_ASSISTANT_PROVIDER=openai
#   ECHONEURA_OPENAI_API_KEY=sk-...
